# Copy this file to `.env` and fill in the values.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth — generate a secret with: openssl rand -base64 32
# (also signs the "are you a person?" passes and scrambles rate-limit keys)
NEXTAUTH_SECRET="your-nextauth-secret"
# Base URL of the app (no trailing slash). Also used in /.well-known/security.txt.
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Server-side YouTube Data API key (used for video search)
YOUTUBE_API_KEY="your-youtube-api-key"

# Secret Vercel sends to the daily refresh job (pages/api/cron/refresh-videos.ts),
# which keeps stored YouTube data under 30 days old. openssl rand -base64 32
CRON_SECRET=

# Public contact address shown on the privacy, terms and security pages, and in
# /.well-known/security.txt (required before applying for more YouTube quota).
NEXT_PUBLIC_CONTACT_EMAIL=

# Admins (comma-separated emails): can take poll entries off the ballot and
# preview results once voting closes.
ADMIN_EMAILS=

# Recommended in production: rate limits shared by every server instance
# (Upstash Redis, REST API). Without these, each instance counts in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recommended in production: the "are you a person?" check (Cloudflare
# Turnstile) on new accounts and on sudden bursts of ratings. Set both, then
# rebuild: the site key is built into the page and the CSP.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: YouTube searches allowed per day across everyone (default 90; the
# default search.list allowance is 100 a day). Raise it once YouTube grants more.
# YOUTUBE_SEARCH_DAILY_CALLS=90
# YOUTUBE_SEARCH_PER_MEMBER=15

# Optional: videos.list lookups (1 unit each, up to 50 ids) per member and site-wide per day.
# YOUTUBE_LOOKUPS_PER_MEMBER=400
# YOUTUBE_LOOKUPS_DAILY=8000

# Optional: new accounts per network per day, and site-wide per hour.
# SIGNUPS_PER_IP_DAILY=25
# SIGNUPS_HOURLY=1000

# Optional: ratings on one video within an hour that flag it for review.
# RATING_BURST_PER_HOUR=15
