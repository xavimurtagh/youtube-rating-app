# Copy this file to `.env` and fill in the values.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret"
# Base URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Server-side YouTube Data API key (used for video search)
YOUTUBE_API_KEY="your-youtube-api-key"

# Secret Vercel sends to the daily refresh job (pages/api/cron/refresh-videos.ts),
# which keeps stored YouTube data under 30 days old. openssl rand -base64 32
CRON_SECRET=

# Public contact address shown on the privacy and terms pages (required before
# applying for more YouTube quota).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: YouTube searches allowed per day across everyone (default 90; the
# default search.list allowance is 100 a day). Raise it once YouTube grants more.
# YOUTUBE_SEARCH_DAILY_CALLS=90
