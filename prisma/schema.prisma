// Prisma schema for the YouTube Rating App.
// After changing this file, apply it to the database with `npx prisma db push`
// (this project does not use a migrations history) and regenerate the client
// with `npx prisma generate`.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  avatar         String?          // URL
  bio            String?          @db.VarChar(280)
  passwordHash   String?          // optional: the app authenticates via Google OAuth

  // Privacy controls (enforced server-side).
  discoverable         Boolean @default(true)  // appear in user search
  publicProfile        Boolean @default(true)  // others can view your ratings/favorites
  showActivity         Boolean @default(true)  // your ratings appear in followers' feeds
  allowRecommendations Boolean @default(true)  // use your ratings to personalize recommendations

  favourites     Video[] @relation("Favourites")
  ratings        Rating[]
  followers      Follow[] @relation("Followee")
  following      Follow[] @relation("Follower")
  activities     Activity[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Video {
  id            String   @id                      // youtubeId
  title         String
  channel       String
  thumbnail     String?
  category      String?                            // YouTube category name, when known
  isMusic       Boolean   @default(false)
  // YouTube data must be refreshed within 30 days of being fetched. A daily
  // job (pages/api/cron/refresh-videos.ts) re-fetches anything older than 25.
  duration      String?                            // ISO 8601, e.g. PT18M40S
  publishedAt   DateTime?
  refreshedAt   DateTime?
  available     Boolean   @default(true)           // false once YouTube stops serving it

  favourites    User[]    @relation("Favourites")
  ratings       Rating[]

  @@index([refreshedAt])
}

model Rating {
  id        String   @id @default(uuid())
  user      User     @relation(fields:[userId], references:[id])
  userId    String
  video     Video    @relation(fields:[videoId], references:[id])
  videoId   String
  score     Int      // 1-10
  ratedAt   DateTime @default(now())

  @@unique([userId, videoId])
}

model Follow {
  id          String   @id @default(uuid())
  follower    User     @relation("Follower", fields:[followerId], references:[id])
  followerId  String
  followee    User     @relation("Followee", fields:[followeeId], references:[id])
  followeeId  String
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeId])
}

model Activity {
  id        String   @id @default(uuid())
  user      User     @relation(fields:[userId], references:[id])
  userId    String
  type      String               // "rating" | "favourite"
  videoId   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A day's cache of YouTube search results, keyed by the normalised query.
/// Each row stands for one search.list call, so counting today's rows also
/// tells us how much of the daily search budget is spent.
model SearchCache {
  query     String   @id
  results   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Atomic counters for daily budgets, such as YouTube searches per day and
/// per member. Keys include the Pacific date; the daily job clears old rows.
model UsageCounter {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
